{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Resume Schema",
  "description": "结构化简历的标准 schema，所有 resume-writing 脚本的统一数据格式",
  "type": "object",
  "required": ["basic_info", "experience"],
  "properties": {
    "basic_info": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "target_position": {"type": "string", "description": "目标岗位，写在简历最顶部"},
        "years_experience": {"type": "number"},
        "phone": {"type": "string"},
        "email": {"type": "string"},
        "city": {"type": "string"},
        "linkedin": {"type": "string"},
        "github": {"type": "string"},
        "portfolio": {"type": "string"}
      }
    },
    "summary": {
      "type": "string",
      "description": "1–3 句一句话定位，资深岗强烈建议；应届可省略"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "position", "start_date"],
        "properties": {
          "company": {"type": "string", "description": "公司全称，不知名公司加（行业，规模）注释"},
          "position": {"type": "string"},
          "location": {"type": "string"},
          "start_date": {"type": "string", "description": "格式 YYYY.MM"},
          "end_date": {"type": "string", "description": "格式 YYYY.MM 或 'Present'"},
          "bullets": {
            "type": "array",
            "description": "按 XYZ 公式写的成就，最强的放第一条",
            "items": {
              "type": "object",
              "properties": {
                "text": {"type": "string"},
                "metrics": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "本条 bullet 的量化数字，用于评分"
                },
                "keywords": {
                  "type": "array",
                  "items": {"type": "string"},
                  "description": "本条覆盖的关键词，用于关键词命中分析"
                },
                "xyz_grade": {
                  "type": "string",
                  "enum": ["A", "B", "C", "D", "F"],
                  "description": "diagnose 阶段打的分"
                }
              }
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string"},
          "role": {"type": "string"},
          "start_date": {"type": "string"},
          "end_date": {"type": "string"},
          "tech_stack": {"type": "array", "items": {"type": "string"}},
          "bullets": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["school", "degree"],
        "properties": {
          "school": {"type": "string"},
          "degree": {"type": "string", "description": "学位：本科/硕士/博士 / Bachelor/Master/PhD"},
          "major": {"type": "string"},
          "start_date": {"type": "string"},
          "end_date": {"type": "string"},
          "gpa": {"type": "string", "description": "建议 ≥3.0/4.0 才写"},
          "honors": {"type": "array", "items": {"type": "string"}},
          "relevant_courses": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "skills": {
      "type": "object",
      "description": "ATS 关键词集中区，分类列出",
      "properties": {
        "hard_skills": {
          "type": "array",
          "items": {"type": "string"},
          "description": "技术、工具、语言、平台"
        },
        "soft_skills": {
          "type": "array",
          "items": {"type": "string"}
        },
        "languages": {
          "type": "array",
          "items": {"type": "string"},
          "description": "自然语言能力，如 英语 CET-6"
        },
        "certifications": {
          "type": "array",
          "items": {"type": "string"},
          "description": "证书：PMP, CFA, AWS Certified 等"
        }
      }
    },
    "_meta": {
      "type": "object",
      "description": "解析与诊断元数据，不进最终简历",
      "properties": {
        "source_file": {"type": "string"},
        "lang": {"type": "string", "enum": ["zh", "en", "mixed"]},
        "diagnose_score": {"type": "number"},
        "diagnose_issues": {"type": "array", "items": {"type": "string"}},
        "tailored_for_jd": {"type": "string"}
      }
    }
  }
}
